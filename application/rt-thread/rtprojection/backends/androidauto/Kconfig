source "packages/third-party/rt-androidauto/Kconfig"

menu "Android Auto backend"
config RTANDROIDAUTO_PROTOCOL_MINOR
    int "Requested AAP 1.x minor version ceiling"
    default 1
    range 1 7
    help
      Keep 1 for the conservative development profile. A higher ceiling
      permits lower-version negotiation but does not enable every optional
      service or establish compatibility with that Android Auto version.

config RTANDROIDAUTO_USB
    bool "CherryUSB AOA transport on the dedicated phone host port"
    default y
    depends on LPKG_USING_RT_ANDROIDAUTO && LPKG_CHERRYUSB_HOST

config RTANDROIDAUTO_CREDENTIAL_DIR
    string "Provisioned TLS identity and peer pin directory"
    default "/data/androidauto"
    help
      Requires client.pem, client.key and peer.sha256 (32 raw bytes).
      No default identity, test key or trust-all policy is installed.

config SETTINGS
    bool
    help
      Zephyr settings core backed by the shared Luban-Lite DFS adapter.

config RTANDROIDAUTO_WIRELESS
    bool "Wireless AA: WPA2 5GHz AP, Bluetooth RFCOMM bootstrap and TCP"
    default n
    depends on LPKG_USING_RT_ANDROIDAUTO && AIC_WLAN_REALTEK
    depends on RT_USING_LWIP && LWIP_USING_DHCPD && RT_USING_DFS
    depends on LPKG_USING_ZEPHYR_BLUETOOTH && LPKG_BT_CLASSIC && LPKG_BT_RFCOMM
    select SETTINGS
    select LPKG_BT_SETTINGS
    help
      Requires provisioned wireless.conf and TLS credentials. Pairing uses
      explicit numeric comparison via the androidauto_pair shell command.
      This development profile does not advertise HFP. Phones that require
      an established real HFP connection may not start wireless projection.

config RTANDROIDAUTO_WIRELESS_DEFAULT
    bool "Select wireless transport at boot (receiver remains unarmed)"
    depends on RTANDROIDAUTO_WIRELESS && !RTANDROIDAUTO_AUTO_START
    default n

config RTANDROIDAUTO_USB_BUS
    int "CherryUSB bus for the dedicated Android phone connector"
    default 1 if AIC_USING_USB0_HOST
    default 0
    range 0 1
    depends on RTANDROIDAUTO_USB
    help
      USB1 is bus 0 when USB0 is not a host, and bus 1 when both are hosts.
      The AOA adapter never sends vendor requests to another host bus.

config RTANDROIDAUTO_AUTO_START
    bool "Arm wired receiver automatically at boot"
    default n
    depends on RTANDROIDAUTO_USB

config RTANDROIDAUTO_VIDEO
    bool "MPP H.264 decoder and DE video output"
    default y
    depends on (RTANDROIDAUTO_USB || RTANDROIDAUTO_WIRELESS) && AIC_MPP_H264_DEC_ENABLE

config RTANDROIDAUTO_AUDIO
    bool "Media/System/Speech PCM playback through sound0"
    default y
    depends on (RTANDROIDAUTO_USB || RTANDROIDAUTO_WIRELESS) && RT_USING_AUDIO
endmenu
