Import('AIC_ROOT')
Import('PRJ_KERNEL')
Import('PRJ_APP')
import os
from building import *

cwd = GetCurrentDir()
objs = []
list = os.listdir(cwd)

for d in list:
    if d == 'rt-carplay' and PRJ_APP == 'rt-carplay-demo':
        continue
    path = os.path.join(cwd, d)
    if os.path.isfile(os.path.join(path, 'SConscript')):
        objs = objs + SConscript(os.path.join(d, 'SConscript'))

Return('objs')
