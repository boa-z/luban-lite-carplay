# USB Vendor Driver
if GetDepend(['LPKG_CHERRYUSB_HOST_VENDEOR']):
    if GetDepend(['LPKG_CHERRYUSB_VENDOR_CH34x']):
        src += usb_glob('class/serial/usbh_ch34x.c')
    if GetDepend(['LPKG_CHERRYUSB_VENDOR_CP210x']):
        src += usb_glob('class/serial/usbh_cp210x.c')
