    if GetDepend(['LPKG_CHERRYUSB_HOST_UVC']):
        src += usb_glob('class/video/usbh_video.c')
        raise RuntimeError('SDK UVC stream adapter requires porting to upstream CherryUSB; legacy binary ABI is unsupported')

    if GetDepend(['LPKG_CHERRYUSB_HOST_UAC']):
        src += usb_glob('class/audio/usbh_audio.c')

    if GetDepend(['LPKG_CHERRYUSB_HOST_DWC2']):
        src += usb_glob('port/dwc2/usb_hc_dwc2.c')
