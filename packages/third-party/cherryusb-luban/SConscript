Import('AIC_ROOT')
Import('PRJ_KERNEL')
from building import *

if not GetDepend('LPKG_USING_CHERRYUSB_V1_5_0'):
    group = []
    Return('group')

cwd = GetCurrentDir()
root = os.path.normpath(os.path.join(cwd, '..', 'cherryusb'))

def apply_usb_patch(target, source, env):
    import subprocess, sys
    return subprocess.call([sys.executable, str(source[2]),
                            str(source[0]), str(source[1]), str(target[0])])

def patched_usb_source(original, patch, output):
    import building
    return building.Env.Command(os.path.join(cwd, 'generated', output),
        [os.path.join(root, original), os.path.join(cwd, 'patches', patch),
         os.path.join(cwd, 'prepare_ehci.py')], apply_usb_patch)

def usb_glob(pattern):
    sdk_files = Glob(os.path.join(cwd, 'sdk', pattern))
    if sdk_files:
        return sdk_files
    files = Glob(os.path.join(root, pattern))
    if not files:
        raise RuntimeError('CherryUSB upstream source unavailable: ' + pattern +
                           '; port this optional SDK feature before enabling it')
    return files
path = [cwd, root + '/common']
path += [root + '/core']
path += [cwd + '/sdk/class/aic', root + '/port/ehci', root + '/port/aic']
path += [root + '/class/cdc', root + '/class/serial']
path += [root + '/class/msc']
path += [root + '/class/mtp']
path += [root + '/class/hid']
path += [root + '/class/audio']
path += [root + '/class/video']
