                src += Glob(os.path.join(cwd, 'usbh_ehci_diag.c'))
                src += Glob(os.path.join(cwd, 'usbh_ehci_rxtrace.c'))
        if GetDepend(['LPKG_CHERRYUSB_HOST_EHCI_HPM']):
            src += usb_glob('port/ehci/usb_glue_hpm.c')

    if GetDepend(['LPKG_CHERRYUSB_HOST_OHCI']):
        src += usb_glob('port/ohci/usb_hc_ohci.c')
        path += [root + '/port/ohci']

    if GetDepend(['LPKG_CHERRYUSB_HOST_XHCI']):
        src += usb_glob('port/xhci/usb_hc_xhci.c')
