# USB Third_party
if GetDepend(['LPKG_CHERRYUSB_THIRD_PARTY']):
    if GetDepend(['LPKG_CHERRYUSB_MEMORY_POOL']):
        src += usb_glob('third_party/cherrymp/chry_mempool.c')
        if PRJ_KERNEL == 'rt-thread':
            src += usb_glob('third_party/cherrymp/chry_mempool_osal_rtthread.c')
        elif PRJ_KERNEL == 'freertos':
            src += usb_glob('third_party/cherrymp/chry_mempool_osal_freertos.c')
        elif PRJ_KERNEL == 'baremetal':
            src += usb_glob('third_party/cherrymp/chry_mempool_osal_nonos.c')
    if GetDepend(['LPKG_CHERRYUSB_RINGBUFFER']):
        src += usb_glob('third_party/cherryrb/*.c')

unique_src = []
for source in src:
    if source not in unique_src:
        unique_src.append(source)
group = DefineGroup('CherryUSB', unique_src, depend = ['LPKG_USING_CHERRYUSB_V1_5_0'], CPPPATH = path, CPPDEFINES = CPPDEFINES, LIBS = libs, LIBPATH = lib_path)

Return('group')
