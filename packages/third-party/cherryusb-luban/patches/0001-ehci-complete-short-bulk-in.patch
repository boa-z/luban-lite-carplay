-static void ehci_qh_scan_qtds(struct usbh_bus *bus, struct ehci_qh_hw *qhead, struct ehci_qh_hw *qh)
+/* A short bulk IN follows alt_next_qtd (terminate), leaving later qTDs
+ * active. Errors also halt execution before the rest of the software chain.
+ * Control IN short data must still complete its status stage. */
+static bool ehci_qtd_ends_urb(const struct usbh_urb *urb, uint32_t token)
+{
+    return (token & QTD_TOKEN_STATUS_ERRORS) ||
+           (USB_GET_ENDPOINT_TYPE(urb->ep->bmAttributes) == USB_ENDPOINT_TYPE_BULK &&
+            (urb->ep->bEndpointAddress & 0x80) &&
+            (token & QTD_TOKEN_NBYTES_MASK));
+}
+
+static bool ehci_qh_scan_qtds(struct usbh_bus *bus, struct ehci_qh_hw *qhead, struct ehci_qh_hw *qh)
 {
     struct ehci_qtd_hw *qtd;
 
     (void)bus;
 
-    ehci_qh_remove(qhead, qh);
+    if (!ehci_qh_remove(qhead, qh)) return false;
 
     qtd = EHCI_ADDR2QTD(qh->first_qtd);
 
     while (qtd) {
-        qtd->urb->actual_length += (qtd->length - ((qtd->hw.token & QTD_TOKEN_NBYTES_MASK) >> QTD_TOKEN_NBYTES_SHIFT));
+#if defined(CONFIG_USB_EHCI_DESC_DCACHE_ENABLE)
+        usb_dcache_invalidate((uintptr_t)&qtd->hw, CONFIG_USB_EHCI_ALIGN_SIZE);
+#endif
+        uint32_t token = qtd->hw.token;
+        if (token & QTD_TOKEN_STATUS_ACTIVE) {
+            break;
+        }
+        qtd->urb->actual_length += (qtd->length - ((token & QTD_TOKEN_NBYTES_MASK) >> QTD_TOKEN_NBYTES_SHIFT));
+        if (ehci_qtd_ends_urb(qtd->urb, token)) {
+            break;
+        }
 
         qtd = EHCI_ADDR2QTD(qtd->hw.next_qtd);
     }
+    return true;
 }
 
