+#ifdef KERNEL_BAREMETAL
+extern struct usbh_bus g_usbhost_bus[CONFIG_USBHOST_MAX_BUS];
+extern void usb_osal_poll_timers(void);
+
+/* Called from the foreground, never from an IRQ or a completion callback. */
+void usbh_hub_poll(void)
+{
+    struct usbh_hub *hub;
+    usb_osal_poll_timers();
+    for (unsigned int i = 0; i < CONFIG_USBHOST_MAX_BUS; ++i) {
+        struct usbh_bus *bus = &g_usbhost_bus[i];
+        /* One bounded queue batch per bus; callbacks may enqueue new work. */
+        for (unsigned int n = 0; bus->hub_mq && n < 7; ++n) {
+            if (usb_osal_mq_recv(bus->hub_mq, (uintptr_t *)&hub, 0) < 0) break;
+            if (hub) usbh_hub_events(hub);
+        }
+    }
+}
+
+/* Detection must not consume the pending connect notification. */
+int usbh_hub_connect_check(void)
+{
+    uint64_t start = aic_get_time_us();
+    do {
+        usbh_hub_poll();
+        for (unsigned int i = 0; i < CONFIG_USBHOST_MAX_BUS; ++i) {
+            struct usbh_bus *bus = &g_usbhost_bus[i];
+            for (unsigned int p = 0; bus->hub_mq && p < bus->hcd.roothub.nports; ++p)
+                if (bus->hcd.roothub.child[p].connected) return 1;
+        }
+    } while (aic_get_time_us() - start < 1000000);
+    return 0;
+}
+#endif
